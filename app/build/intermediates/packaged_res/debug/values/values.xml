<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="medical_bg_light">#F5F6F4</color>
    <color name="medical_error">#B91C1C</color>
    <color name="medical_error_bg">#FEE2E2</color>
    <color name="medical_info_bg">#EFF6FF</color>
    <color name="medical_outline">#D1D5DB</color>
    <color name="medical_primary">#0C604E</color>
    <color name="medical_primary_variant">#094A3D</color>
    <color name="medical_surface">#FFFFFF</color>
    <color name="medical_warning_bg">#FEF3C7</color>
    <color name="medical_warning_text">#92400E</color>
    <color name="on_medical_primary">#FFFFFF</color>
    <color name="text_main">#111827</color>
    <color name="text_sub">#4B5563</color>
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_radius">6dp</dimen>
    <dimen name="card_elevation">1dp</dimen>
    <dimen name="card_radius">8dp</dimen>
    <dimen name="input_radius">6dp</dimen>
    <dimen name="screen_padding">16dp</dimen>
    <dimen name="spacing_huge">32dp</dimen>
    <dimen name="spacing_large">24dp</dimen>
    <dimen name="spacing_medium">16dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_tiny">4dp</dimen>
    <dimen name="text_base">16sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_h1">22sp</dimen>
    <dimen name="text_h2">18sp</dimen>
    <dimen name="text_small">14sp</dimen>
    <string name="app_name">DrugDose</string>
    <string name="app_subtitle">Calcolatore Dermatologico</string>
    <string name="calcola_dose">CALCOLA DOSE</string>
    <string name="formula_vincoli">Seleziona un farmaco per visualizzare i parametri clinici e le formule (es. BSA, mg/kg).</string>
    <string name="hint_altezza">Altezza (cm)</string>
    <string name="hint_eta">Età (anni)</string>
    <string name="hint_peso">Peso (kg)</string>
    <string name="indicazione_clinica">Indicazione Clinica</string>
    <string name="placeholder_altezza">es. 175</string>
    <string name="placeholder_eta">es. 35</string>
    <string name="placeholder_peso">es. 70.5</string>
    <string name="risultato">In attesa di dati...</string>
    <string name="seleziona_farmaco">Seleziona Farmaco</string>
    <string name="titolo_risultato">Esito del Calcolo</string>
    <style name="MedicalButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="backgroundTint">@color/medical_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="MedicalDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
    </style>
    <style name="MedicalTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeColor">@color/medical_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/medical_primary</item>
        <item name="android:textColorHint">@color/text_sub</item>
    </style>
    <style name="Theme.DrugDose" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/medical_primary</item>
        <item name="colorPrimaryVariant">@color/medical_primary_variant</item>
        <item name="colorOnPrimary">@color/on_medical_primary</item>
        <item name="android:windowBackground">@color/medical_bg_light</item>
    </style>
</resources>